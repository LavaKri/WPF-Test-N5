<UserControl x:Class="AccessTest.OngletRichText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <!-- Barre de mise en forme (Specs/RichText.md, 1b) : commandes d'édition de WPF sur l'éditeur ;
             lettres, noms, infobulles et raccourcis posés par AppliquerLangue, état par MajBarreMiseEnForme. -->
        <ToolBarTray x:Name="TrayMiseEnForme" DockPanel.Dock="Top">
            <ToolBar x:Name="BarMiseEnForme">
                <ToggleButton x:Name="TglGras" MinWidth="24"
                              Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <TextBlock x:Name="LettreGras" FontWeight="Bold"/>
                </ToggleButton>
                <ToggleButton x:Name="TglItalique" MinWidth="24"
                              Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <TextBlock x:Name="LettreItalique" FontStyle="Italic"/>
                </ToggleButton>
                <ToggleButton x:Name="TglSouligne" MinWidth="24"
                              Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <TextBlock x:Name="LettreSouligne" TextDecorations="Underline"/>
                </ToggleButton>
                <Separator/>
                <!-- Icônes dessinées, de la couleur du texte du bouton (Contraste élevé). -->
                <RadioButton x:Name="RdoGauche" GroupName="Alignement" MinWidth="24"
                             Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <Path Data="M0,1 H14 M0,5 H9 M0,9 H14 M0,13 H9" StrokeThickness="2" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton x:Name="RdoCentre" GroupName="Alignement" MinWidth="24"
                             Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <Path Data="M0,1 H14 M2.5,5 H11.5 M0,9 H14 M2.5,13 H11.5" StrokeThickness="2" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton x:Name="RdoDroite" GroupName="Alignement" MinWidth="24"
                             Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=RtbEditeur}">
                    <Path Data="M0,1 H14 M5,5 H14 M0,9 H14 M5,13 H14" StrokeThickness="2" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
            </ToolBar>
        </ToolBarTray>
        <!-- Menu contextuel partagé avec le TextBox (Specs/Fenetre.md, 2.7) : posé par MenuEditeurs.Brancher. -->
        <RichTextBox x:Name="RtbEditeur"
                     VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</UserControl>
