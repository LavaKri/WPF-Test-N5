<UserControl x:Class="AccessTest.OngletChoix"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="Libelle" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Margin" Value="0,6,10,0"/>
                </Style>
            </Grid.Resources>

            <GroupBox x:Name="GrpCouleur" Grid.Row="0" Grid.Column="1" Margin="0,4"
                      HorizontalAlignment="Left" MinWidth="200" Padding="8">
                <GroupBox.ContextMenu>
                    <ContextMenu x:Name="CtxCouleur">
                        <MenuItem x:Name="MnuCouleurLimiter" IsCheckable="True" IsChecked="True"/>
                    </ContextMenu>
                </GroupBox.ContextMenu>
                <StackPanel x:Name="PnlCouleur">
                    <RadioButton x:Name="RdoRouge" GroupName="Couleur" Margin="0,2"/>
                    <RadioButton x:Name="RdoVert" GroupName="Couleur" Margin="0,2" IsChecked="True"/>
                    <RadioButton x:Name="RdoBleu" GroupName="Couleur" Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="LblQcm" Style="{StaticResource Libelle}" Grid.Row="1" Grid.Column="0"/>
            <ListBox x:Name="LstQcm" Grid.Row="1" Grid.Column="1" Margin="0,4"
                     HorizontalAlignment="Left" MinWidth="200" SelectionMode="Multiple">
                <ListBoxItem x:Name="ItmNord"/>
                <ListBoxItem x:Name="ItmSud"/>
                <ListBoxItem x:Name="ItmEst"/>
                <ListBoxItem x:Name="ItmOuest"/>
            </ListBox>

            <CheckBox x:Name="ChkTroisEtats" Grid.Row="2" Grid.Column="1" Margin="0,8"
                      HorizontalAlignment="Left" IsThreeState="True" IsChecked="False"/>

            <ToggleButton x:Name="TglBascule" Grid.Row="3" Grid.Column="1" Margin="0,4"
                          HorizontalAlignment="Left" MinWidth="120" Padding="12,3"/>

            <TextBlock x:Name="LblCalendrier" Style="{StaticResource Libelle}" Grid.Row="4" Grid.Column="0"/>
            <Calendar x:Name="CalCalendrier" Grid.Row="4" Grid.Column="1" Margin="0,4"
                      HorizontalAlignment="Left" SelectionMode="SingleDate">
                <Calendar.ContextMenu>
                    <ContextMenu x:Name="CtxCalendrier">
                        <MenuItem x:Name="MnuCalDemain" Click="CalDemain_Click"/>
                        <MenuItem x:Name="MnuCalMasquerJours" IsCheckable="True"/>
                    </ContextMenu>
                </Calendar.ContextMenu>
            </Calendar>

            <TextBlock x:Name="LblDate" Style="{StaticResource Libelle}" Grid.Row="5" Grid.Column="0"/>
            <DatePicker x:Name="DatDate" Grid.Row="5" Grid.Column="1" Margin="0,4"
                        HorizontalAlignment="Left" MinWidth="200"/>

            <TextBlock x:Name="LblCurseur" Style="{StaticResource Libelle}" Grid.Row="6" Grid.Column="0"/>
            <Slider x:Name="SldCurseur" Grid.Row="6" Grid.Column="1" Margin="0,4"
                    Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="10"
                    TickFrequency="10" TickPlacement="BottomRight">
                <Slider.ContextMenu>
                    <ContextMenu x:Name="CtxCurseur">
                        <MenuItem x:Name="MnuCurseurScrollbar" IsCheckable="True" IsChecked="True"/>
                    </ContextMenu>
                </Slider.ContextMenu>
            </Slider>

            <TextBlock x:Name="LblDefilement" Style="{StaticResource Libelle}" Grid.Row="7" Grid.Column="0"/>
            <ScrollBar x:Name="ScbDefilement" Grid.Row="7" Grid.Column="1" Margin="0,4"
                       Orientation="Horizontal" Minimum="0" Maximum="100"
                       Value="{Binding Value, ElementName=SldCurseur, Mode=TwoWay}"
                       ViewportSize="10" SmallChange="1" LargeChange="10"/>
        </Grid>
    </ScrollViewer>
</UserControl>
